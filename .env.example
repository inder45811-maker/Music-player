# ---------------------------------------------------------------------------
# Environment configuration template.
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Only variables prefixed with `PUBLIC_` are exposed to the browser bundle.
# Everything else stays server-side and is read via `$env/static/private`.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/social_music?schema=public"

# --- Session / crypto -----------------------------------------------------
# 32+ byte random secret used to sign/verify session tokens and CSRF tokens.
SESSION_SECRET="replace-with-a-long-random-string"

# Public origin of the app, used to build OAuth redirect URIs and validate
# CSRF Origin/Referer headers.
PUBLIC_APP_ORIGIN="http://localhost:5173"

# --- Email (verification + password resets) -------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="no-reply@example.com"

# --- Social login: Google -------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Social login: Apple --------------------------------------------------
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# --- Music API: Spotify ---------------------------------------------------
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# --- Music API: SoundCloud ------------------------------------------------
SOUNDCLOUD_CLIENT_ID=""
SOUNDCLOUD_CLIENT_SECRET=""

# --- Music API: YouTube Data API v3 ---------------------------------------
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_API_KEY=""

# --- Music API: Apple MusicKit --------------------------------------------
APPLE_MUSIC_TEAM_ID=""
APPLE_MUSIC_KEY_ID=""
APPLE_MUSIC_PRIVATE_KEY=""
